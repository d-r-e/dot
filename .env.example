# Optional overrides for dot. run.sh reads ../.env (the repository root), so
# merge these values there or export them in your shell before ./run.sh.
# Never commit real tokens.

DOT_HOST=127.0.0.1
DOT_PORT=8765
# LAN: DOT_HOST=0.0.0.0 plus every URL you will open, or the origin check
# rejects /api/chat and /ws/voice. Browsers only expose the microphone on a
# secure origin, so LAN voice needs DOT_TLS=1 (self-signed, .tls/ ignored).
# DOT_HOST=0.0.0.0
# DOT_ALLOWED_ORIGINS=http://192.168.1.20:8765,https://192.168.1.20:8765
# DOT_TLS=1
LLAMA_HOST=127.0.0.1
LLAMA_PORT=1234

# LLAMA_BIN=$HOME/Projects/llama.cpp/build/bin/llama-server
# MODEL=models/Nemotron-3.5-Bolt-E4B-Q4_K_M.gguf
# DRAFTER=models/Nemotron-3.5-Bolt-E4B-DFlash-BF16.gguf
CTX=32768
NGL=99

# KEEP_LLAMA=1
# LLAMA_NO_SPAWN=1
# DFLASH=1

# Automatic tools: emotion and an isolated headless browser (ARIA refs).
# DOT_TOOLS=1
# DOT_BROWSE=1
# DOT_BROWSE_TIMEOUT=20
# DOT_WEATHER_TIMEOUT=8
# DOT_TOOL_ROUNDS=6

# VAD_SILENCE_MS=700
# VAD_THRESHOLD=0.5
# MAX_TURN_S=30
# Spanish defaults (English: af_heart / a / en-US).
# TTS_VOICE=ef_dora
# TTS_LANG=e
# ASR_LANGUAGE=es-ES
# ASR_DELAY_MS=160
# VOICE_WARMUP=1
